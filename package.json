{
  "name": "sica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:local": "VITE_SICA_MODE=local vite",
    "build": "tsc -b && vite build",
    "build:local": "VITE_SICA_MODE=local tsc -b && VITE_SICA_MODE=local vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node scripts/test-domain.mjs && node scripts/test-files.mjs",
    "test:all": "node scripts/test-all.mjs",
    "test:database": "node scripts/build-server.mjs && node --import ./scripts/test-offline-guard.mjs scripts/test-database.mjs",
    "test:postgres": "node scripts/build-server.mjs && node scripts/postgres-test-cluster.mjs",
    "postgres:data": "node scripts/build-server.mjs && node --env-file-if-exists=.env scripts/postgres-data.mjs",
    "verify:database": "node scripts/build-server.mjs && node scripts/verify-relational-history.mjs",
    "build:server": "node scripts/build-server.mjs",
    "server": "node scripts/build-server.mjs && node --env-file-if-exists=.env server/start.mjs",
    "dev:shared": "VITE_SICA_MODE=server vite --host 127.0.0.1 --port 5174 --strictPort",
    "build:shared": "VITE_SICA_MODE=server tsc -b && VITE_SICA_MODE=server vite build",
    "test:server": "node scripts/build-server.mjs && node --import ./scripts/test-offline-guard.mjs scripts/test-server.mjs",
    "test:fiscal": "node scripts/build-server.mjs && node --import ./scripts/test-offline-guard.mjs scripts/test-fiscal.mjs",
    "recovery": "node scripts/build-server.mjs && node scripts/recover-server.mjs",
    "test:recovery": "node scripts/build-server.mjs && node scripts/test-recovery.mjs",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "supabase:prepare": "node --env-file-if-exists=.env scripts/supabase-prepare.mjs",
    "supabase:bootstrap": "node scripts/supabase-bootstrap.mjs",
    "build:edge": "node scripts/build-server.mjs && node scripts/build-edge.mjs",
    "test:edge": "node scripts/build-server.mjs && node --import ./scripts/test-offline-guard.mjs --test scripts/test-edge.mjs",
    "supabase:verify": "node scripts/build-server.mjs && node --env-file=.env scripts/supabase-live.mjs",
    "test:cloud": "node scripts/build-server.mjs && node --import ./scripts/test-offline-guard.mjs --test scripts/test-cloud.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsqr": "^1.4.0",
    "oxlint": "^1.75.0",
    "rolldown": "1.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "source-map-js": "^1.2.2"
  }
}
