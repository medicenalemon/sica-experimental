# Requiere Node.js 24. La primera ejecución necesita una contraseña elegida
# por el administrador (12 a 1024 caracteres). No hay contraseña por defecto.
VITE_SICA_MODE=server
# Backend Edge opcional (sin claves privadas en VITE_*):
# VITE_SICA_API_URL=https://dudraffygijvufwhqvza.supabase.co/functions/v1/sica-api
# VITE_SICA_EDGE_REGION=us-west-2
SICA_ADMIN_PASSWORD=
# PostgreSQL es el backend predeterminado. Credenciales sólo en .env, nunca VITE_*.
SICA_DATABASE_DRIVER=postgres
SICA_DATABASE_URL=postgresql://sica:CAMBIAR_CLAVE@127.0.0.1:55432/sica
SICA_AUDIT_KEY_FILE=var/postgres/sica.audit-key
# Supabase: copiar la URL de Connect > Session pooler, puerto 5432.
# Se verifica TLS automáticamente para toda conexión remota.
# Si el certificado del servidor requiere CA propia, elegir una de estas fuentes:
# SICA_DATABASE_SSL_CA_FILE=/app/certificates/supabase-ca.crt
# SICA_DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
SICA_DATABASE_POOL_SIZE=4
# Docker público: dominio con DNS al servidor, sin protocolo ni ruta.
# SICA_DOMAIN=sica.ejemplo.com
# Sólo para el PostgreSQL opcional de compose.yaml; elegir clave y reflejarla en URL.
SICA_POSTGRES_PASSWORD=
# SQLite queda disponible explícitamente para compatibilidad/migración.
# SICA_DATABASE_DRIVER=sqlite
SICA_DATABASE=var/sica.sqlite
SICA_COMPANY_ID=sica
# Multiempresa opcional: archivo JSON siguiendo server/companies.example.json.
# Cada empresa requiere su propia base y contraseña inicial por variable de entorno.
# SICA_COMPANIES_FILE=server/companies.local.json
# SICA_COMPANY_ID=textil
# SICA_TEXTIL_ADMIN_PASSWORD=
# SICA_SERVICIOS_ADMIN_PASSWORD=
SICA_HOST=127.0.0.1
SICA_PORT=3001
# Agregar el origen HTTPS real al publicar detrás de un proxy seguro.
SICA_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:5174,http://localhost:5174
SICA_SECURE_COOKIE=false

# ARCA: deshabilitado por defecto. Modos: disabled, homologacion, produccion.
# Homologación usa certificados WSASS vinculados a wsfe. Producción requiere
# certificados productivos y relación/delegación de wsfe para el CUIT emisor.
# Elegir produccion dirige las solicitudes autorizadas por el operador al ambiente real.
# Nunca reutilizar certificados de otro ambiente. La aplicación conserva ambos historiales.
SICA_ARCA_MODE=disabled
SICA_ARCA_CUIT=
SICA_ARCA_CERTIFICATE=
SICA_ARCA_PRIVATE_KEY=
SICA_ARCA_KEY_PASSWORD=
